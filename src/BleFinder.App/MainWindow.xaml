<Window x:Class="BleFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BleFinder.App.Controls"
        Title="محدد أجهزة BLE"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="580"
        FlowDirection="RightToLeft"
        Language="ar">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="محدد أجهزة BLE" />
                <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding StartCommand}" Content="بدء المسح" />
                <Button Command="{Binding StopCommand}" Content="إيقاف المسح" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tracking}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel DataContext="{Binding Tracking}">
                <Button HorizontalAlignment="Right"
                        Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="رجوع" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock FlowDirection="LeftToRight" Text="{Binding AddressText}" />
                <TextBlock Text="{Binding RssiText}" />
                <TextBlock Text="{Binding BandLabel}" />
                <TextBlock Text="{Binding TrendText}" />
                <TextBlock Text="{Binding Freshness}" />
                <CheckBox Content="الصوت"
                          IsChecked="{Binding SoundEnabled, Mode=TwoWay}" />
                <controls:SignalHistoryControl Samples="{Binding History}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tracking}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="ابحث بالاسم أو العنوان" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceCountText}" />
                <CheckBox Grid.Column="2"
                          Content="إخفاء العناوين"
                          IsChecked="{Binding HideAddresses, Mode=TwoWay}" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Address}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock FlowDirection="LeftToRight" Text="{Binding AddressText}" />
                                    <TextBlock Text="{Binding RssiText}" />
                                    <ProgressBar Maximum="100" Value="{Binding StrengthPercent}" />
                                    <TextBlock Text="{Binding BandLabel}" />
                                    <TextBlock Text="{Binding Freshness}" />
                                    <TextBlock Text="{Binding LastSeenText}" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Address}"
                                    Content="نسخ العنوان" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
